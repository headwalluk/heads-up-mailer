# Deny access to all maintainer tooling in this directory.
#
# These are developer scripts, never runtime code — `bin` is listed in
# .distignore so it is absent from release zips, but it IS present in a
# repo checkout, and a plugins directory is web-accessible. Without this,
# the shell scripts here are fetchable over HTTP.
#
# Two branches so the rule survives either module set: mod_authz_core is
# the Apache 2.4 form, and the Order/Deny form is 2.2 (available on 2.4
# only while mod_access_compat is enabled). Guarding both means disabling
# mod_access_compat can't turn this file into a 500 for the directory.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    <Files *>
        Order Allow,Deny
        Deny from all
    </Files>
</IfModule>
