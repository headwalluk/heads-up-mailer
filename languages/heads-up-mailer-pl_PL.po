#: includes/class-plugin.php:259
#: includes/class-plugin.php:260
msgid "Heads Up Mailer"
msgstr "Uwaga: wiadomość e-mail"

#. Plugin URI of the plugin
#: heads-up-mailer.php
msgid "https://headgit.net/headwall/heads-up-mailer"
msgstr "https://headgit.net/headwall/heads-up-mailer"

#. Description of the plugin
#: heads-up-mailer.php
msgid "In-house newsletter sender for headwall-hosting.com. Async send queue, RFC-8058 one-click unsubscribe, IMAP poll for mailto unsubscribes."
msgstr "Własny system do wysyłania biuletynów dla serwisu headwall-hosting.com. Asynchroniczna kolejka wysyłkowa, rezygnacja z subskrypcji jednym kliknięciem zgodnie z RFC-8058 oraz sprawdzanie skrzynek IMAP pod kątem rezygnacji z subskrypcji za pośrednictwem linków „mailto”."

#. Author of the plugin
#: heads-up-mailer.php
msgid "Paul Faulkner"
msgstr "Paul Faulkner"

#. Author URI of the plugin
#: heads-up-mailer.php
msgid "https://headwall-hosting.com"
msgstr "https://headwall-hosting.com"

