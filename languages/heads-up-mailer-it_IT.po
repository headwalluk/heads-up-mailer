msgid "Heads Up Mailer"
msgstr "Avviso via e-mail"

#. Plugin URI of the plugin
#: heads-up-mailer.php
msgid "https://headgit.net/headwall/heads-up-mailer"
msgstr "https://headgit.net/headwall/heads-up-mailer"

#. Description of the plugin
#: heads-up-mailer.php
msgid "In-house newsletter sender for headwall-hosting.com. Async send queue, RFC-8058 one-click unsubscribe, IMAP poll for mailto unsubscribes."
msgstr "Sistema di invio newsletter interno per headwall-hosting.com. Coda di invio asincrona, cancellazione dell'iscrizione con un solo clic secondo lo standard RFC-8058, polling IMAP per le richieste di cancellazione tramite mailto."

#. Author of the plugin
#: heads-up-mailer.php
msgid "Paul Faulkner"
msgstr "Paul Faulkner"

#. Author URI of the plugin
