#: includes/class-plugin.php:259
#: includes/class-plugin.php:260
msgid "Heads Up Mailer"
msgstr "Ενημερωτικό δελτίο Heads Up"

#. Plugin URI of the plugin
#: heads-up-mailer.php
msgid "https://headgit.net/headwall/heads-up-mailer"
msgstr "https://headgit.net/headwall/heads-up-mailer"

#. Description of the plugin
#: heads-up-mailer.php
msgid "In-house newsletter sender for headwall-hosting.com. Async send queue, RFC-8058 one-click unsubscribe, IMAP poll for mailto unsubscribes."
msgstr "Ενσωματωμένη υπηρεσία αποστολής ενημερωτικών δελτίων για το headwall-hosting.com. Ουρά ασύγχρονης αποστολής, διαγραφή με ένα κλικ σύμφωνα με το RFC-8058, έλεγχος IMAP για διαγραφές μέσω mailto."

#. Author of the plugin
#: heads-up-mailer.php
msgid "Paul Faulkner"
msgstr "Πολ Φόλκνερ"

#. Author URI of the plugin
