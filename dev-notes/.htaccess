# Deny all web access to the design record.
#
# dev-notes/ is build-time documentation, never runtime code. Part of it
# ships in the release zip (the tracker and design notes are useful to a
# maintainer reading an installed copy), and ALL of it is present on a
# site deployed from the repo source — so in both cases these files are
# otherwise fetchable over HTTP at a guessable URL.
#
# This matters more than it looks: `*-private.md` notes are git-ignored
# and never published, but being absent from the repo does nothing to
# stop the local file being served off the disk it lives on.
#
# Two branches so the rule survives either module set: mod_authz_core is
# the Apache 2.4 form, and the Order/Deny form is 2.2 (present on 2.4
# only while mod_access_compat is enabled). Guarding both means
# disabling mod_access_compat can't turn this into a 500 for the
# directory.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    <Files *>
        Order Allow,Deny
        Deny from all
    </Files>
</IfModule>
